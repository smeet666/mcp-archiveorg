{
  "name": "mcp-archiveorg",
  "version": "2.0.0",
  "description": "MCP server for the Internet Archive. Search inside digitised books, browse the catalogue, and read Wayback Machine snapshots. No API key required.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "internet-archive",
    "archive-org",
    "wayback-machine",
    "full-text-search",
    "open-library",
    "books"
  ],
  "homepage": "https://github.com/smeet666/mcp-archiveorg#readme",
  "bugs": {
    "url": "https://github.com/smeet666/mcp-archiveorg/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/smeet666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smeet666/mcp-archiveorg.git"
  },
  "license": "MIT",
  "author": {
    "name": "Damien Bouissou",
    "url": "https://github.com/smeet666"
  },
  "type": "module",
  "bin": {
    "mcp-archiveorg": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/ia/client.d.ts",
      "import": "./dist/ia/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRIVACY.md",
    "server.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "mcpName": "io.github.smeet666/mcp-archiveorg",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "coverage": "vitest run test/unit --coverage",
    "test:live": "vitest run test/live --testTimeout=90000",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "build:manifest": "npm run build && node scripts/build-manifest-tools.mjs",
    "format": "biome check --write && prettier --write \"**/*.{md,yml}\"",
    "check": "biome ci && prettier --check \"**/*.{md,yml}\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
